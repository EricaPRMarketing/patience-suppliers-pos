{
  "name": "patience-suppliers-pos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preview": "VITE_ROUTER=memory vite build && python3 scripts/inline_preview.py",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:demo": "tsc -b && VITE_DEMO=true vite build --outDir dist-demo && cd dist-demo && rm -f ../patience-pos-demo.zip && zip -qr ../patience-pos-demo.zip ."
  },
  "dependencies": {
    "dexie": "4.0.11",
    "dexie-react-hooks": "1.1.7",
    "papaparse": "5.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.18.5",
    "read-excel-file": "9.0.10"
  },
  "devDependencies": {
    "@types/papaparse": "5.3.16",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "fake-indexeddb": "6.0.1",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-pwa": "1.0.0",
    "vitest": "3.2.3"
  }
}
